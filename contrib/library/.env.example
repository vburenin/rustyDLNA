# Copy to a gitignored location or export in the operator shell.
# Do not commit real values. rustyDLNA itself does not read these variables.

# Media library root. Also accepted as --root or LIBRARY_ROOT.
# RUSTY_DLNA_MEDIA=/path/to/media

# Optional TMDB read token for About text, genre corroboration, and age ratings.
# TMDB_API_TOKEN=
# TMDB_API_KEY=

# Optional OMDb keys for full plots. Comma-separated failover list is preferred.
# OMDB_API_KEYS=
# OMDB_API_KEY=

# Optional age-certification region (default US).
# AGE_RATING_REGION=US

# Optional owner for fix-genre-permissions.sh when run through sudo.
# LIBRARY_USER=

# Optional path to dovi_tool if it is not on PATH.
# DOVI_TOOL=
