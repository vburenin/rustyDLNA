# Browser-only gateway. This image contains nginx and the route policy below;
# it does not contain the rustyDLNA binary, FFmpeg, a scanner, media mounts, or
# any SSDP/UPnP listener.
FROM nginx:mainline-alpine@sha256:4a73073bd557c65b759505da037898b61f1be6cbcc3c2c3aeac22d2a470c1752

ARG BUILD_VERSION=dev
ARG VCS_REF=unknown
ARG BUILD_DATE=1970-01-01T00:00:00Z

LABEL org.opencontainers.image.source="https://github.com/vburenin/rustyDLNA" \
      org.opencontainers.image.licenses="GPL-2.0-only AND BSD-2-Clause" \
      org.opencontainers.image.title="rustyDLNA browser gateway" \
      org.opencontainers.image.version="$BUILD_VERSION" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.created="$BUILD_DATE"

COPY web-gateway/nginx.conf /etc/nginx/nginx.conf
COPY LICENSE /usr/share/doc/rusty-web/LICENSE
COPY THIRD_PARTY_NOTICES.md /usr/share/doc/rusty-web/THIRD_PARTY_NOTICES.md

EXPOSE 8080/tcp

STOPSIGNAL SIGQUIT
USER 101:101
ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
