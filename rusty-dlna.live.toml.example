# Copy to rusty-dlna.live.toml (gitignored) and point
# RUSTY_DLNA_CONF at it from .env.
friendly_name = "rustyDLNA"
media_dir = ["V,/storage/video"]
exclude_dir = ["incomplete"]
# ASCII case-insensitive basename globs (`*` and `?`).
# exclude_file = ["*-extra.*"]
include_hidden = false
# album_art_names = ["AlbumArt.jpg", "{stem}-cover.jpg"]
subtitles = true
thumbnails = true
thumbnail_width = 320
thumbnail_quality = 2
thumbnail_filmstrip = false
scan_command_timeout_secs = 30
scan_workers = 16
helper_max_jobs = 16
helper_queue_capacity = 64
helper_queue_timeout_secs = 30
shutdown_timeout_secs = 15
recent_limit = 200
# recent_days = 90 # optional filesystem-mtime age window
# Set true only if outside-root symlink targets are intentionally public.
wide_links = false
root_container = "V"
listen_ip = "0.0.0.0"
# LAN address written into SSDP LOCATION and description URLs.
advertise_ip = "192.168.1.10"
cache_dir = "/var/cache/rusty-dlna"
db_dir = "/var/cache/rusty-dlna"
derived_image_cache_mb = 512
derived_image_cache_age_days = 30
# FFmpeg JPEG qscale for on-demand resized images (2 is highest quality).
derived_image_quality = 8
cache_min_free_mb = 128
notify_interval = 180
# Full walks start daily. Unchanged or expensive walks back off as far as one
# week; inotify continues applying ordinary file updates without a root walk.
rescan_secs = 86400
rescan_max_secs = 604800
# 0 means indefinitely; this deployment keeps Kodi state for three months.
bookmark_retention_days = 90
# Generate a stable uuid so clients do not see a new device every rebuild.
# uuid = "uuid:xxxxxxxx-xxxx-4xxx-8xxx-xxxxxxxxxxxx"

[web]
enable = true
# Use h264_nvenc with the NVIDIA Compose override documented in WEB_PLAYER.md.
encoder = "libx264"
ai_upscale_max_jobs = 1
# Optional ordered external neural-shader profiles are documented in
# WEB_PLAYER.md. They require h264_nvenc and are disabled by default.

[transcode]
# Original browser playback remains available when false; Compatible playback
# and configured DLNA remap jobs require this gate.
enable = true
encoder = "libx264"
max_jobs = 16
cache_max_mb = 51200
cache_max_age_days = 30

