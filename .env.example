# Copy to .env and edit. .env is gitignored.
TZ=UTC
RUSTY_DLNA_MEDIA=./media
# Stable Docker-managed cache/database volume, reused by restart.sh.
# ./restart.sh --clean discards this volume; Compose recreates it empty.
RUSTY_DLNA_CACHE_VOLUME=rusty-dlna-cache
