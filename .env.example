# Copy to .env and edit. .env is gitignored.
TZ=UTC
RUSTY_DLNA_MEDIA=./media
# Stable Docker-managed cache/database volume, reused by restart.sh.
# ./restart.sh --clean discards this volume; Compose recreates it empty.
RUSTY_DLNA_CACHE_VOLUME=rusty-dlna-cache
# RUSTY_DLNA_CONF=./rusty-dlna.live.toml
# RUST_LOG=info
# RUSTY_DLNA_START_TIMEOUT=120
# Set to 1 for one restart after externally copying root-owned files into the cache.
# RUSTY_DLNA_REPAIR_OWNERSHIP=0
# Browser-only gateway. Loopback is safest when the TLS/auth proxy runs on the
# host; use a specific host/LAN address when that proxy runs in a container.
# RUSTY_WEB_BIND_IP=127.0.0.1
# RUSTY_WEB_PORT=8201
# RUSTY_WEB_START_TIMEOUT=60
