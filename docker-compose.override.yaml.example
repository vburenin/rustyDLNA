# Copy to docker-compose.override.yaml and edit the host paths.
# docker-compose.override.yaml is gitignored and merged automatically.
services:
  rusty-dlna:
    environment:
      TZ: UTC
      # Vulkan tone mapping also needs the NVIDIA "graphics" capability.
      # NVIDIA_DRIVER_CAPABILITIES: compute,video,utility,graphics
    # Uncomment with NVIDIA Container Toolkit for NVENC/NVDEC/Vulkan access.
    # gpus: all
    volumes:
      - /path/to/your/videos:/storage/video:ro
      # If DETAILS.PATH used a different host realpath, bind that path
      # onto itself:
      # - /path/to/realpath:/path/to/realpath:ro
      - /path/to/rusty-dlna-cache:/var/cache/rusty-dlna
      # Optional: local identity (uuid, advertise_ip, remaps)
      # - ./rusty-dlna.live.toml:/etc/rusty-dlna.toml:ro
